<Window x:Class="HW3_WpfApp_TextRedactor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HW3_WpfApp_TextRedactor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar Margin="5" Padding="5">
                <ComboBox Margin="5" Padding="5" SelectedIndex="0" Width="200" SelectionChanged="ComboBox_SelectionChanged">
                    <TextBlock Text="Times New Roman"/>
                    <TextBlock Text="French Script MT"/>
                    <TextBlock Text="Webdings"/>
                </ComboBox>

                <ComboBox Margin="5" Padding="5" SelectedIndex="0" Width="50" SelectionChanged="ComboBox_SelectionChanged_1">
                    <TextBlock Text="16"/>
                    <TextBlock Text="24"/>
                    <TextBlock Text="32"/>
                </ComboBox>
            </ToolBar>
            <ToolBar Margin="5" Padding="5">
                <Button Click="Button_Click">
                    <Image x:Name="imgBold" Source="/Data/bold.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_1">
                    <Image x:Name="imgItalic" Source="/Data/italic.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_2">
                    <Image x:Name="imgUnderline" Source="/Data/underlined.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_3">
                    <Image x:Name="imgStrikethrough" Source="/Data/strikethouht.png" Height="45" Opacity="1"/>
                </Button>
            </ToolBar>
            <ToolBar Margin="5" Padding="5" VerticalAlignment="Center">
                <StackPanel>
                    <RadioButton Content="Черный" IsChecked="True" Checked="RadioButton_Checked"/>
                    <RadioButton Content="Красный" Click="RadioButton_Click"/>
                </StackPanel>
            </ToolBar>
        </ToolBarTray>

        <TextBox x:Name="textBox" Grid.Row="1" Margin ="5" Padding="5" FontSize="12" FontFamily="Arial" TextWrapping="Wrap"/>
    </Grid>
</Window>
