<Window x:Class="HW3_WpfApp_TextRedactor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HW3_WpfApp_TextRedactor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="MenuItem_ClickOpen"/>
        <CommandBinding Command="Save" Executed="MenuItem_ClickSave"/>
        <CommandBinding Command="Close" Executed="MenuItem_ClickShutdown"/>
        <CommandBinding Command="local:MyCommands.Bold" Executed="Button_Click_to_Bold"/>
        <CommandBinding Command="local:MyCommands.Italic" Executed="Button_Click_to_Itallic"/>
        <CommandBinding Command="local:MyCommands.Underlined" Executed="Button_Click_to_Uderline"/>
        <CommandBinding Command="local:MyCommands.Strikethrough" Executed="Button_Click_to_Strikethrough"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0" Padding="0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть" Command="ApplicationCommands.Open" />
                <MenuItem Header="_Сохранить" Command="ApplicationCommands.Save" />
                <Separator />
                <MenuItem Header="_Выход" Command="ApplicationCommands.Close" />
            </MenuItem>
            <MenuItem Header="_Инструменты">
                <MenuItem Name="menuBold" Header="Жирный" IsCheckable="True" IsChecked="False" Command="local:MyCommands.Bold"/>
                <MenuItem Name="menuItalic" Header="Курсив" IsCheckable="True" IsChecked="False" Command="local:MyCommands.Italic"/>
                <MenuItem Name="menuUndrln" Header="Подчеркнутый" IsCheckable="True" IsChecked="False" Command="local:MyCommands.Underlined"/>
                <MenuItem Name="menuStrke" Header="Зачеркнутый" IsCheckable="True" IsChecked="False" Command="local:MyCommands.Strikethrough"/>
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1">
            <ToolBar Margin="5" Padding="5">
                <ComboBox Margin="5" 
                          Padding="5" 
                          SelectedIndex="0" 
                          Width="200" 
                          SelectionChanged="ComboBox_SelectionChanged"
                          ItemsSource="{StaticResource fonts}"/>


                <ComboBox Margin="5" 
                          Padding="5" 
                          SelectedIndex="0" 
                          Width="50" 
                          SelectionChanged="ComboBox_SelectionChanged_1"
                          ItemsSource="{StaticResource sizes}"/>


            </ToolBar>
            <ToolBar Margin="5" Padding="5">
                <Button Command="local:MyCommands.Bold">
                    <Image x:Name="imgBold" Source="/Data/bold.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_to_Itallic">
                    <Image x:Name="imgItalic" Source="/Data/italic.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_to_Uderline">
                    <Image x:Name="imgUnderline" Source="/Data/underlined.png" Height="45" Opacity="1"/>
                </Button>
                <Button Click="Button_Click_to_Strikethrough">
                    <Image x:Name="imgStrikethrough" Source="/Data/strikethouht.png" Height="45" Opacity="1"/>
                </Button>
            </ToolBar>
            <ToolBar Margin="5" Padding="5" VerticalAlignment="Center">
                <StackPanel>
                    <RadioButton Content="Черный" IsChecked="True" Checked="RadioButton_Checked"/>
                    <RadioButton Content="Красный" Click="RadioButton_Click"/>
                </StackPanel>
            </ToolBar>
        </ToolBarTray>

        <TextBox x:Name="textBox" Grid.Row="2" Margin ="5" Padding="5" FontSize="12" FontFamily="Arial" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
